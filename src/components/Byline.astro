---
import { formatDate } from '@/lib/posts';

interface Props {
  author?: string;
  date: string;
  readTime: number;
}
const { author = 'Kodi', date, readTime } = Astro.props;
---
<div class="art-byline">
  <span class="mono-meta">
    BY {author.toUpperCase()} · {readTime} MIN · {formatDate(date).toUpperCase()}
  </span>
</div>

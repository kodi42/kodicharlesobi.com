# Copy this to .env and fill in. .env is git-ignored.

# Base64-encoded (or raw JSON) service account key from GCP.
# In the Cloudflare dashboard, paste the raw JSON — the lib handles both.
GOOGLE_SERVICE_ACCOUNT_JSON=

# The Google Drive folder ID that contains your posts. Extract from the
# folder URL: https://drive.google.com/drive/folders/<THIS_PART>
DRIVE_FOLDER_ID=

# Cloudflare Pages Deploy Hook URL (create in Pages → Settings → Builds).
DEPLOY_HOOK_URL=

# Shared secret used by the webhook endpoint + drive.files.watch registration.
# Generate with `openssl rand -hex 32`.
WEBHOOK_TOKEN=

# Public URL of the webhook, used only by scripts/register-watch.ts.
# Example: https://kodi-blog.pages.dev/api/drive-webhook
WEBHOOK_URL=
